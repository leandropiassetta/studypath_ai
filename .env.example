# Copie para `.env` (que é ignorado pelo git) e ajuste. NUNCA coloque chaves reais neste arquivo.
# Os valores abaixo funcionam como estão, sem IA: com AI_MODE=disabled a API usa só os textos de referência.

# --- Servidor (uso local: a API fala HTTP puro e escuta só em 127.0.0.1) ---
APP_ENV=demo
HOST=127.0.0.1
PORT=3000

# --- Banco de dados e fila (docker compose: `npm run db:up`) ---
# Credenciais locais do docker-compose.yml; não são segredos.
DATABASE_URL=postgres://studypath:studypath@127.0.0.1:5432/studypath
# Tarefas em segundo plano (BullMQ). Sem REDIS_URL elas ficam desligadas e o app funciona igual.
REDIS_URL=redis://127.0.0.1:6379
# Marca "prazo vencido" quando a dúvida segue sem resposta. Padrão: 14 min (840000). Baixe para demonstrar.
# SLA_DELAY_MS=840000

# --- IA ---
# disabled = só texto de referência | mock = respostas fixas, sem rede | real = chama o provedor abaixo
AI_MODE=disabled
AI_TIMEOUT_MS=8000
# Limites de custo por aluno, somando explicações, dicas e a análise em segundo plano.
AI_MAX_CALLS_PER_MINUTE=6
AI_MAX_CALLS_PER_DAY=50
# Para usar IA de verdade (AI_MODE=real), a chave e o modelo são obrigatórios.
# Provedor gratuito: Groq (formato compatível com a OpenAI). Crie a chave em https://console.groq.com
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=
# Outros provedores: LLM_PROVIDER=openai sem LLM_BASE_URL usa a OpenAI;
# LLM_PROVIDER=anthropic usa a Anthropic (ex.: LLM_MODEL=claude-haiku-5-5).

# --- Sessões e cadastro ---
# Quantos dias dura um login.
SESSION_TTL_DAYS=7
# Cadastro de professor por convite: quem tiver este código cria conta de professor (mínimo de 8
# caracteres). Sem a variável, ninguém consegue se cadastrar como professor.
# TEACHER_INVITE_CODE=

# --- Contas de demonstração (usadas por `npm run db:seed` e `npm run demo:setup`) ---
# São fictícias e só valem neste computador. As senhas precisam de pelo menos 6 caracteres.
# DEMO_EMAIL=aluna.demo@exemplo.dev
# DEMO_PASSWORD=
# TEACHER_EMAIL=professora@exemplo.dev
# TEACHER_PASSWORD=
# TEACHER_NAME=Profa. Helena
# Id fixo da aluna de demonstração (só mude se souber o motivo).
DEMO_STUDENT_ID=55555555-5555-4555-8555-555555555555
