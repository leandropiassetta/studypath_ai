APP_ENV=demo
HOST=127.0.0.1
PORT=3000
# Local development credentials (matches docker-compose.yml). Not secrets.
DATABASE_URL=postgres://studypath:studypath@127.0.0.1:5432/studypath
DEMO_STUDENT_ID=55555555-5555-4555-8555-555555555555
# P1 explanations: disabled | mock | real. "real" requires LLM_API_KEY and LLM_MODEL (never commit them).
AI_MODE=disabled
AI_TIMEOUT_MS=8000
# Cost guards per student for real LLM calls (cache hits do not count).
AI_MAX_CALLS_PER_MINUTE=6
AI_MAX_CALLS_PER_DAY=50
# LLM_PROVIDER=anthropic   # or openai
# LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5   # for openai use an OpenAI model id available to your account

# Sessions: how long a login lasts (days).
SESSION_TTL_DAYS=7
# Optional login for the seeded demo student (used only by `npm run db:seed`; never commit real ones).
# DEMO_EMAIL=demo@exemplo.dev
# DEMO_PASSWORD=

# Background jobs (BullMQ). Without REDIS_URL they are simply off. `npm run db:up` also starts Redis.
# REDIS_URL=redis://127.0.0.1:6379
# SLA_DELAY_MS=840000   # flag doubts still waiting for a teacher after 14 min (lower it to demo)
# Free LLM option: Groq speaks the OpenAI protocol. Create a free key at console.groq.com, then:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai
# LLM_MODEL=llama-3.3-70b-versatile
